                                CueText{text: route.title + "：" + route.draft draw_text.text_style.font_size: 12}
                                CueText{text: "相关原文片段：\n" + cue_refs_excerpt(cue_route_refs(route.body)) draw_text.color: cue_muted draw_text.text_style.font_size: 10}
                                View{width: Fill height: Fit flow: Right spacing: 3
                                    CueButton{text: "选用这句" on_click: || cue_choose_route(i)}
                                    CueLink{text: "查看假设对白" on_click: || cue_select_preview(i)}
                                }
                            }
                        }
                    }}
                }
                CueCard{
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        CueCap{text: "草稿"}
                        cue_draft := TextInput{width: Fill height: 70 is_multiline: true empty_text: "选路线后用这句放入草稿，再改" on_change: |text| cue_edit_draft(text)
                            draw_bg +: {color: #xf5f7f3 color_hover: #xf5f7f3 color_focus: #xf5f7f3 color_empty: #xf5f7f3 border_radius: 7.0}
                            draw_text +: {color: cue_ink color_hover: cue_ink color_focus: cue_ink color_empty: cue_muted color_empty_hover: cue_muted text_style.font_size: 12}
                        }
                    }
                    View{width: Fill height: Fit flow: Right{wrap: true} spacing: 2
                        CueButton{text: "保留这句" on_click: || cue_keep_draft()}
                        CueLink{text: "取回草稿" padding: Inset{left: 4 right: 4} on_click: || cue_restore_draft()}
                        CueButton{text: "存 A" on_click: || cue_keep_take(0)}
                        CueLink{text: "取 A" padding: Inset{left: 4 right: 4} on_click: || cue_restore_take(0)}
                        CueLink{text: "显示 A" padding: Inset{left: 4 right: 4} on_click: || cue_read_take(0)}
                        CueButton{text: "存 B" on_click: || cue_keep_take(1)}
                        CueLink{text: "取 B" padding: Inset{left: 4 right: 4} on_click: || cue_restore_take(1)}
                        CueLink{text: "显示 B" padding: Inset{left: 4 right: 4} on_click: || cue_read_take(1)}
                    }
                    View{width: Fill height: Fit flow: Right{wrap: true} spacing: 2
                        CueLink{text: "原句/当前对照" on_click: || cue_compare(0)}
                        CueLink{text: "A/B对照" on_click: || cue_compare(1)}
                    }
                    cue_comparison := View{width: Fill height: Fit flow: Down spacing: 3 on_render: || {
                        let before = cue_editor_base
                        let after = cue_editor_text
                        if cue_compare_mode == 1 { before = cue_take_a after = cue_take_b }
                        if before != "" || after != "" {
                            CueText{text: "前：" + before draw_text.color: cue_muted draw_text.text_style.font_size: 11}
                            CueText{text: "后：" + after draw_text.text_style.font_size: 12}
                        }
                        let label = "人工编辑，未作完整事实校验"
                        if cue_editor_origin == "model" { label = "助手候选，仅经格式/引用/数字/承诺规则检查" }
                        if cue_editor_origin == "demo" { label = "本地虚构样例" }
                        if cue_editor_origin == "legacy" { label = "旧版未分组草稿的手动复制" }
                        if cue_compare_mode == 0 {
                            CueText{text: label + " · 文本版本 " + cue_editor_revision draw_text.color: cue_muted draw_text.text_style.font_size: 10}
                            if cue_editor_snapshot != "" { CueText{text: "来源快照：" + cue_editor_snapshot + "；重新载入后须复核，旧稿不会自动更新。" draw_text.color: cue_muted draw_text.text_style.font_size: 10} }
                        } else { CueText{text: "A/B为本房间已保存文本；取回后再核对各自来源。" draw_text.color: cue_muted draw_text.text_style.font_size: 10} }
                    }}
                    cue_refine_input := TextInput{width: Fill height: 48 is_multiline: true empty_text: "修改要求，例如更短但保留拒绝" on_change: |text| cue_edit_refine(text)
                        draw_bg +: {color: #xf5f7f3 color_hover: #xf5f7f3 color_focus: #xf5f7f3 color_empty: #xf5f7f3 border_radius: 7.0}
                        draw_text +: {color: cue_ink color_empty: cue_muted text_style.font_size: 12}
                    }
                    CueButton{text: "准备修订候选" on_click: || cue_refine()}
                    cue_refinement := View{width: Fill height: Fit flow: Down spacing: 3 on_render: || {
                        if cue_pending_revision != "" {
                            CueText{text: "原稿：" + cue_refine_base draw_text.color: cue_muted}
                            CueText{text: "修订候选：" + cue_pending_revision}
                            CueText{text: cue_pending_note draw_text.color: cue_muted draw_text.text_style.font_size: 11}
                            CueText{text: "依据原文片段：\n" + cue_refs_excerpt(cue_refine_refs) draw_text.color: cue_muted draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right spacing: 4
                                CuePrimary{text: "应用修订" on_click: || cue_apply_refinement()}
                                CueButton{text: "不采用" on_click: || {cue_cancel_candidate() cue_sync_workspace()}}
                            }
                        }
                    }}
                    cue_storage_state := View{width: Fill height: Fit flow: Down spacing: 2 on_render: || {
                        CueLink{text: "本地草稿管理 / 删除 / 旧版迁移" on_click: || cue_toggle_storage()}
                        if cue_storage_open || !cue_store_ready {
                        CueText{text: "按账号/房间隔离，样例单存。仅支持一个写入窗口；无崩溃原子性保证。" draw_text.color: cue_muted draw_text.text_style.font_size: 10}
                        if !cue_store_ready { CueText{text: cue_store_error draw_text.color: #xa03425 draw_text.text_style.font_size: 11} }
                        View{width: Fill height: Fit flow: Right{wrap: true} spacing: 2
                            CueLink{text: "重新读取存储" on_click: || cue_reload_store()}
                            CueLink{text: "删除本房间草稿" on_click: || cue_request_delete(cue_room_id)}
                            CueLink{text: "旧版未分组草稿" on_click: || cue_toggle_legacy()}
                        }
                        if cue_legacy_open {
                            CueText{text: "主稿/A/B不会自动属于当前房间。点下方仅复制到编辑框，保存后旧副本仍保留。" draw_text.color: cue_muted draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right{wrap: true} spacing: 2
                                CueButton{text: "复制旧主稿" on_click: || cue_import_legacy(0)}
                                CueButton{text: "复制旧A" on_click: || cue_import_legacy(1)}
                                CueButton{text: "复制旧B" on_click: || cue_import_legacy(2)}
                                CueLink{text: "删除三份旧版文件" on_click: || cue_request_delete("legacy")}
                            }
                        }
                        if !cue_store_ready { CueLink{text: "清空全部新格式记录并解锁" on_click: || cue_request_delete("all")} }
                        if cue_delete_target != "" {
                            let label = "删除本房间主稿和A/B（不含旧版副本）"
                            if cue_delete_target == "legacy" { label = "永久移除三份旧版文件（不含已经复制的新稿）" }
                            if cue_delete_target == "all" { label = "移除所有房间的新格式草稿，包括无法读取的记录" }
                            CueText{text: label + "？不可撤销；确认30秒有效。" draw_text.color: #xa03425 draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 4
                                CueButton{text: "确认删除" on_click: || cue_confirm_delete()}
                                CueButton{text: "取消删除" on_click: || cue_cancel_delete()}
                            }
                        }
                        }
                    }}
                }
                CueCard{
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        CueButton{text: "A 顺着说" on_click: || cue_select_preview(0)}
                        CueButton{text: "B 换问法" on_click: || cue_select_preview(1)}
                        CueButton{text: "C 换玩法" on_click: || cue_select_preview(2)}
                        Label{text: "" width: Fill}
                        CueButton{text: "用这句" on_click: || cue_choose_route(cue_play_index)}
                    }
                    header := View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5} on_render: || {
                    if cue_read_mode == 1 {
                        Label{text: "相关原文" draw_text.color: cue_green draw_text.text_style.font_size: 13}
                    } else {
                        if cue_read_mode == 2 {
                            let name = "版本 A"
                            if cue_take_read == 1 { name = "版本 B" }
                            Label{text: name draw_text.color: cue_green draw_text.text_style.font_size: 13}
                        } else {
                            if cue_routes.len() > 0 {
                                Label{text: cue_routes[cue_play_index].title draw_text.color: cue_green draw_text.text_style.font_size: 13}
                            } else {
                                Label{text: "假设对白" draw_text.color: cue_green draw_text.text_style.font_size: 13}
                            }
                        }
                    }
                    let total = cue_ws_pages.len()
                    if total < 1 { total = 1 }
                    let shown = cue_ws_page + 1
                    if shown > total { shown = total }
                    Label{text: "第 " + shown + " 页 / 共 " + total + " 页" width: Fill draw_text.color: cue_muted draw_text.text_style.font_size: 11}
                }}
                    RoundedView{width: Fill height: Fit min_height: 257 flow: Down padding: 6 new_batch: true draw_bg.color: #xf5f7f3
                        readout := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
                        let idx = cue_ws_page
                        if idx >= cue_ws_pages.len() { idx = 0 }
                        if cue_read_mode == 0 {
                            if cue_routes.len() == 0 {
                                CueText{text: "先写一句想接的话，点「试映下一幕」。再点 A、B、C，逐句看三种说法。"}
                            } else {
                                CueText{text: cue_ws_pages[idx]}
                            }
                        } else {
                            if cue_read_mode == 1 {
                                if cue_summary == "" {
                                    CueText{text: "还没有相关原文：先点「试映下一幕」。"}
                                } else {
                                    CueText{text: cue_ws_pages[idx]}
                                }
                            } else {
                                if cue_take_a == "" && cue_take_b == "" {
                                    CueText{text: "先改好一句存 A，再改另一句存 B。关闭后仍可取回对照。"}
                                } else {
                                    let cur = cue_take_a
                                    if cue_take_read == 1 { cur = cue_take_b }
                                    if cur == "" {
                                        CueText{text: "这一版还没有内容；点另一版，或先在草稿框写好再存一版。"}
                                    } else {
                                        CueText{text: cue_ws_pages[idx]}
                                    }
                                }
                            }
                        }
                    }}
                    }
                    View{width: Fill height: Fit flow: Right{wrap: true} spacing: 2 align: Align{y: 0.5}
                        cue_play_button := CueLink{text: "播放" on_click: || cue_toggle_playback()}
                        CueLink{text: "下一句" on_click: || cue_next_line()}
                        CueLink{text: "重播" on_click: || cue_restart_playback()}
                        CueLink{text: "上一页" on_click: || cue_page_prev()}
                        CueLink{text: "下一页" on_click: || cue_page_next()}
                        CueLink{text: "对白" on_click: || cue_show_dialogue()}
                        CueLink{text: "相关原文" on_click: || cue_show_summary()}
                    }
                }
            }
        }
                CueCard{
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        cue_scene_label := Label{text: "样例舞台 · 国庆搭子局" width: Fill draw_text.color: cue_ink draw_text.text_style: theme.font_bold{font_size: 12}}
                        CueButton{text: "展开/收起参考消息" on_click: || cue_toggle_sources()}
                    }
                    cue_msg_list := View{width: Fill height: Fit flow: Down spacing: 2 on_render: || {
                        if !cue_sources_open { CueText{text: "已载入 " + cue_sources.len() + " 条；展开核对原文并选择本次请求范围。" draw_text.color: cue_muted draw_text.text_style.font_size: 11} }
                        if cue_sources_open {
                        if cue_sources.len() == 0 {
                            CueText{text: "还没有消息。点「样例舞台」或「载入群聊」。" draw_text.color: cue_muted}
                        }
                        for i in cue_sources.len() {
                            let s = cue_sources[i]
                            let include_text = "☑ #" + (i + 1)
                            if !cue_source_enabled(i) { include_text = "□ #" + (i + 1) }
                            CueLink{text: include_text on_click: || cue_toggle_source(i)}
                            if cue_is_selected(i) {
                                RoundedView{width: Fill height: Fit flow: Right spacing: 6 padding: Inset{left: 8 right: 8 top: 3 bottom: 3} new_batch: true draw_bg.color: #xe5eee7
                                    Label{text: "#" + (i + 1) width: 36 draw_text.color: cue_green draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{text: s.sender + "：" + s.body width: Fill draw_text.color: cue_ink draw_text.text_style.font_size: 13}
                                }
                            } else {
                                View{width: Fill height: Fit flow: Right spacing: 6 padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                    Label{text: "#" + (i + 1) width: 36 draw_text.color: cue_muted draw_text.text_style.font_size: 11}
                                    Label{text: s.sender + "：" + s.body width: Fill draw_text.color: cue_ink draw_text.text_style.font_size: 13}
                                }
                            }
                        }
                        }
                    }}
                    CueText{text: "浅绿是助手选出的关联，不是事实支持已核验。" draw_text.color: cue_muted draw_text.text_style.font_size: 11}
                }
        CueText{text: "三种说法是助手的假设。应用不会替你发送任何消息。" draw_text.color: cue_muted draw_text.text_style.font_size: 10}
    }
}
