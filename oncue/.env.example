# 复制为 .env，填写自己的值；.env 不属于交付包。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M2.7
# 对外监听时至少24字符。默认启动仅监听127.0.0.1，可留空。
ONCUE_ACCESS_TOKEN=
# 填浏览器实际访问的主机名，不含协议或端口，用逗号分隔。
ONCUE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# 使用HTTPS反向代理时设为1；本地HTTP或SSH转发时留为0。
ONCUE_SECURE_COOKIE=0
