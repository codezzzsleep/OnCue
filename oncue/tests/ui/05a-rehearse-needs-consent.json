{
  "name": "S4/A14 未点「允许并试映」前对助手零调用；点一次完成允许和试映",
  "use": "_room.json",
  "steps": [
    {
      "run": "_load.json"
    },
    {
      "expect": {
        "calls": [
          {
            "service": "octos.session.open",
            "count": 0
          },
          {
            "service": "octos.turn.start",
            "count": 0
          }
        ]
      }
    },
    {
      "expect": {
        "text": [
          "这次发给助手：台词、目标和勾选消息正文（不含名字）"
        ]
      }
    },
    {
      "scroll_to": "允许并试映"
    },
    {
      "click": "允许并试映"
    },
    {
      "wait": {
        "text": [
          "三种说法好了。",
          "已放进草稿框"
        ]
      },
      "timeout": 5
    },
    {
      "expect": {
        "calls": [
          {
            "service": "octos.session.open",
            "count": 1
          },
          {
            "service": "octos.turn.start",
            "count": 1
          }
        ]
      }
    }
  ]
}
