  },
  "steps": [
    {
      "run": "_load.json"
    },
    {
      "run": "_rehearse.json"
    },
    {
      "scroll_to": {
        "text": "选用这句",
        "after": {
          "contains": "顺着这句："
        }
      }
    },
    {
      "click": {
        "text": "选用这句",
        "after": {
          "contains": "顺着这句："
        }
      }
    },
    {
      "wait": {
        "text": [
          "已过期：群里新增 1 条消息"
        ]
      }
    },
    {
      "scroll_to": [
        {
          "contains": "qixi：我改主意了，想住一晚。"
        },
        {
          "text": "选用这句",
          "after": {
            "contains": "顺着这句："
          }
        }
      ]
    },
    {
      "click": {
        "text": "选用这句",
        "after": {
          "contains": "顺着这句："
        }
      }
    },
    {
      "sleep": 0.5
    },
    {
      "scroll_to": {
        "id": "cue_draft"
      }
    },
    {
      "expect": {
        "calls": [
          {
            "service": "matrix.read_messages",
            "count": 2
          }
        ],
        "count": [
          {
            "of": {
              "id": "cue_draft",
              "contains": "那就中午以后出发"
            },
            "n": 0
          }
        ]
      }
    }
