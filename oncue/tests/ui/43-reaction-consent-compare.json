  "steps": [
    {
      "wait": {
        "text": [
          "原消息已载入，共 3 条。"
        ]
      },
      "timeout": 5
    },
    {
      "scroll_to": {
        "id": "cue_draft"
      }
    },
    {
      "type": {
        "into": {
          "id": "cue_draft"
        },
        "text": "预算 300 左右包括车票吗？"
      }
    },
    {
      "scroll_to": "发到群里"
    },
    {
      "click": "发到群里"
    },
    {
      "wait": {
        "text": [
          "请核对完整正文后点「确认发送」"
        ]
      },
      "timeout": 5
    },
    {
      "scroll_to": "确认发送"
    },
    {
      "click": "确认发送"
    },
    {
      "wait": {
        "text": [
          "已发到 周末出游群。刚才读回时看到了这条。"
        ]
      },
      "timeout": 5
    },
    {
      "scroll_to": "看反响"
    },
    {
      "click": "看反响"
    },
    {
      "wait": {
        "text": [
          "发出那条之后的回复"
        ]
      },
      "timeout": 5
    },
    {
      "scroll_to": "ayou：车票包在里面，没问题。"
    },
    {
      "expect": {
        "text": [
          "ayou：车票包在里面，没问题。",
          "允许并对照"
        ],
        "absent": [
          "放进确认区",
          "对照好了"
        ],
        "calls": [
          {
            "service": "octos.session.open",
            "count": 0
          },
          {
            "service": "octos.turn.start",
            "count": 0
          }
        ]
      }
    },
    {
      "click": "允许并对照"
    },
    {
      "wait": {
        "text": [
          "对照好了",
          "那中午以后出发，车票信息我发群里。"
        ]
      },
      "timeout": 5
    },
    {
      "expect": {
        "calls": [
          {
            "service": "octos.turn.start",
            "count": 1,
            "excludes": "ayou"
          },
          {
            "service": "octos.turn.start",
            "count": 1,
            "excludes": "qixi"
          }
        ]
      }
    }
